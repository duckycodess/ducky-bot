# TEMPLATE, instanced per profile: enable as
#     ducky-coordinator@development  /  ducky-coordinator@production
#
# %i is the profile name. Each instance gets its own environment file, its own
# database and its own port, so the two bots can never share state or
# credentials. Installing this file is a deliberate operator step.
[Unit]
Description=Ducky coordinator (%i profile)
Documentation=file:///opt/ducky/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ducky
Group=ducky
WorkingDirectory=/opt/ducky

# Per-profile secrets. Mode 0600, owned by this service's user. Unit files are
# world-readable, so never inline a token here.
EnvironmentFile=/etc/ducky/%i.env
Environment=NODE_ENV=production
Environment=DUCKY_PROFILE=%i
Environment=DUCKY_INSTANCE_LABEL=ducky-%i

ExecStart=/usr/bin/node /opt/ducky/packages/coordinator/dist/main.js
Restart=always
RestartSec=5s

# Reloads the executor credential file without a restart, which is what makes
# credential rotation a no-downtime operation.
ExecReload=/bin/kill -HUP $MAINPID

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/var/lib/ducky
ReadOnlyPaths=/opt/ducky /etc/ducky
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
