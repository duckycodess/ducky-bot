# TEMPLATE. Copy to /etc/systemd/system/ and adjust paths and User.
# Installing this file is a deliberate operator step; nothing here installs it.
[Unit]
Description=Ducky coordinator
Documentation=file:///opt/ducky/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ducky
Group=ducky
WorkingDirectory=/opt/ducky

# Secrets come from an environment file readable only by this service's user.
# Never inline a token in a unit file: unit files are world-readable.
EnvironmentFile=/etc/ducky/coordinator.env
Environment=NODE_ENV=production

ExecStart=/usr/bin/node /opt/ducky/packages/coordinator/dist/main.js
Restart=always
RestartSec=5s

# SIGHUP reloads the executor credential file without a restart, which is what
# makes credential rotation a no-downtime operation.
ExecReload=/bin/kill -HUP $MAINPID

# The coordinator needs its database, its config and its credential file.
# Nothing else on the filesystem should be reachable.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/var/lib/ducky
ReadOnlyPaths=/opt/ducky /etc/ducky

# Loopback and the tailnet are enough; there is no public listener.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
