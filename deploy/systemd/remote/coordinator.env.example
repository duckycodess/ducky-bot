# EXAMPLE ONLY. Copy to ~/.config/ducky/coordinator-<profile>.env, chmod 0600.
# systemd does NOT expand specifiers inside an EnvironmentFile: replace USER with the real account name.
# Contains NO secrets here; every secret value is filled in on the host and never
# committed. Use the profile-scoped names for the profile this file belongs to.

DUCKY_PROFILE=development
OWNER_DISCORD_USER_ID=
# The listener is loopback. Reach it from a phone through tailnet-only
# `tailscale serve` on this host (never `tailscale funnel`); the phone page and
# the coordinator routes share this one listener.
DUCKY_HTTP_HOST=127.0.0.1
DUCKY_HTTP_PORT=8787
DUCKY_DB_PATH=/home/USER/.local/state/ducky/development/ducky.db
DUCKY_REPOS_FILE=/home/USER/.config/ducky/repos-development.json

# Per-profile secrets, filled in on the host:
# DISCORD_DEV_TOKEN=
# DISCORD_DEV_APP_ID=
# DISCORD_DEV_GUILD_ID=
# DUCKY_DEV_COMPONENT_SIGNING_KEY=
# DUCKY_DEV_EXECUTOR_CREDENTIALS_FILE=/home/USER/.config/ducky/executor-credentials-development.json
# DUCKY_DEV_PHONE_PASSCODE_VERIFIER=      # from `pnpm phone:passcode`

# OFF until shared admission exists. Do not set these to 1 as part of installing.
# DUCKY_ENGINEERING_ENABLED=0
# DUCKY_ENGINEERING_ATTEMPT_MINUTES=60
DUCKY_ADDITIONAL_USER_AI_ENABLED=0

# Subscription-only: the process refuses to start if ANY *_API_KEY name is set
# (OPENAI_API_KEY, ANTHROPIC_API_KEY and the rest). Leave them all unset.
