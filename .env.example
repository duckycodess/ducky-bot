# Ducky coordinator configuration. Copy to .env and fill in.
# Every value here is a PLACEHOLDER. Never commit a filled-in copy.

# ---- identity -----------------------------------------------------------
# The single Discord user id that owns this assistant. Required.
# Exactly one id: captures, inbox, schedules, tasks, reminders, briefings, jobs
# and repository data are private personal data and only this account can reach
# them.
OWNER_DISCORD_USER_ID=000000000000000000

# Optional, comma separated. These users get CONVERSATION ONLY -- never
# captures, inbox, schedules, tasks, reminders, briefings, jobs, approvals or
# repository information.
CHAT_WHITELIST_USER_IDS=

# ---- profile ------------------------------------------------------------
# Which Discord identity this instance is: development | production.
# The two profiles share NOTHING -- separate bot, database, port and command
# scope -- and never fall back to one another. Keep a separate env file per
# profile (.env.development / .env.production) rather than one shared file.
DUCKY_PROFILE=development
# Shown in diagnostics and /status so two instances are never confused.
DUCKY_INSTANCE_LABEL=

# ---- discord: development bot -------------------------------------------
# Leave the token unset to run locally against the mock transport.
# Both bots need the privileged MessageContent intent enabled in the Discord
# developer portal before they can read owner DMs.
# Development commands register to DISCORD_DEV_GUILD_ID so they appear
# immediately; that guild is required whenever a dev token is set.
DISCORD_DEV_TOKEN=
DISCORD_DEV_APP_ID=
DISCORD_DEV_GUILD_ID=

# ---- discord: production bot --------------------------------------------
# A production instance FAILS TO START without its own token. It never borrows
# the development bot, and never registers into the development guild.
# Leave DISCORD_PROD_GUILD_ID unset to register production commands globally.
DISCORD_PROD_TOKEN=
DISCORD_PROD_APP_ID=
DISCORD_PROD_GUILD_ID=

DISCORD_CDN_HOSTS=cdn.discordapp.com,media.discordapp.net

# ---- secrets: profile-scoped -------------------------------------------
# EVERY secret is per profile, not just the Discord ones. A shared component
# key would let a control minted by one bot verify on the other; a shared
# executor credential file would let a development executor claim production
# jobs.
#
# At least 32 bytes of base64url randomness each. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Startup fails closed if the selected profile's key is missing or too short;
# there is no unsigned fallback for Discord component ids.
DUCKY_DEV_COMPONENT_SIGNING_KEY=replace-me-with-32-random-bytes-base64url
DUCKY_PROD_COMPONENT_SIGNING_KEY=

# Executor credentials, one file per profile. The file must be mode 0600 and
# owned by the coordinator's own user, or it is refused.
# Create entries with: pnpm executor:issue-credential --executor <id>
DUCKY_DEV_EXECUTOR_CREDENTIALS_FILE=./config/executor-credentials.dev.json
DUCKY_PROD_EXECUTOR_CREDENTIALS_FILE=

# A single-profile development box may still use the unscoped names below.
# Production NEVER reads them -- it requires its own DUCKY_PROD_* values.
# DUCKY_COMPONENT_SIGNING_KEY=
# DUCKY_EXECUTOR_CREDENTIALS_FILE=./config/executor-credentials.json
# Development and tests only. Refused outright when NODE_ENV=production.
# DUCKY_EXECUTOR_CREDENTIALS={"version":1,"executors":[]}

# ---- shared job visibility ----------------------------------------------
# OPT IN. Comma-separated Discord CHANNEL ids in which anyone who can read the
# channel may run /jobs and /job status and see a SAFE PROJECTION of a job:
# public id, allowlisted repo slug, coarse state, safe timestamps, sanitized
# summary and verdict, and what happens next. Never the task, context, owner
# id, questions, answers, events, workspace paths, action details or any
# control.
#
# Scoped PER CHANNEL: a channel shows only the jobs submitted in it. Jobs from
# a DM or from another listed channel are not visible there, by id or
# otherwise. Listing a channel shares the work started in it, not your history.
#
# Default empty, which switches the whole feature off.
#
# This is a VISIBILITY setting, not an authorization one. It says where
# information may be shown, never who may act: every write stays owner-only
# and every owner-only reply stays ephemeral regardless of what is listed
# here. Lock the channel down in Discord to the people you intend to see it --
# membership is enforced by Discord's channel permissions, not by Ducky.
#
# Profile-scoped like every other cross-profile setting. Production reads ONLY
# DUCKY_PROD_SHARED_CHANNEL_IDS; a development or unscoped value would publish
# real job activity into a test channel.
DUCKY_DEV_SHARED_CHANNEL_IDS=
DUCKY_PROD_SHARED_CHANNEL_IDS=
# Development only, like the other unscoped names above.
# DUCKY_SHARED_CHANNEL_IDS=

# ---- approved actions ---------------------------------------------------
# Explicitly enables the separate owner `/job execute` command. It is OFF by
# default; an approval alone never runs a command. Production reads only its
# own profile flag, never the development or unscoped value.
DUCKY_DEV_APPROVED_ACTIONS_ENABLED=false
DUCKY_PROD_APPROVED_ACTIONS_ENABLED=false
# Development-only convenience for a single-profile local box.
# DUCKY_APPROVED_ACTIONS_ENABLED=false

# ---- storage and http ---------------------------------------------------
# Each of these defaults per profile, so two instances cannot collide by
# accident. Set them explicitly to override.
#   development -> ./data/ducky-dev.db   :8787  ./config/repos.dev.json
#   production  -> ./data/ducky-prod.db  :8788  ./config/repos.json
DUCKY_DB_PATH=
DUCKY_HTTP_HOST=127.0.0.1
DUCKY_HTTP_PORT=
DUCKY_REPOS_FILE=
# One interval drives the reconciler, the job-notification sweep AND the daily
# assistant tick. There is no second scheduler, so this is also the worst-case
# lateness of a reminder.
DUCKY_RECONCILE_INTERVAL_MS=30000
#   credentials development -> ./config/executor-credentials.dev.json
#   credentials production  -> /etc/ducky/executor-credentials-production.json

# ---- daily assistant ----------------------------------------------------
# Your own IANA timezone. Used ONLY as a projection: it decides which civil day
# an instant falls in ("due today", the briefing's day boundary) and what a
# typed wall-clock time means ("tomorrow 09:00"). Every instant is still stored
# as UTC, so changing this re-renders existing rows and never rewrites them --
# there is nothing to migrate either way.
#
# Validated at startup against the runtime's own timezone data, so a typo fails
# loudly at boot rather than silently shifting a day boundary months later.
# Reported in /status and the startup diagnostics.
#
# Not profile-scoped: it describes you, not the bot.
DUCKY_OWNER_TIMEZONE=UTC

# ---- executor (read by the EXECUTOR process, not the coordinator) --------
# Whether the Herdr/Pi orchestrator reports itself verified. Set to `1` ONLY
# after a repeatable production-path certification you ran yourself; nothing in
# the code ever sets it, and /status reports `experimental` while it is unset.
# See docs/integrations/herdr.md.
# DUCKY_HERDR_VERIFIED=1

# ---- conversation attachments (2C) --------------------------------------
# OPT IN, default off. Lets ONE image or file be attached to an ordinary
# conversation message.
#
# This switch alone does nothing. Bytes are fetched only when ALL THREE hold:
#   1. this is on,
#   2. the conversation provider reports itself VERIFIED, and
#   3. that provider declares it accepts attachments.
# No provider on this host is verified, and both advertise no attachment
# support, so today an upload is refused on metadata alone and NOTHING IS
# DOWNLOADED. /status says so.
#
# Attachments are OWNER-ONLY even though plain chat is not: a file is personal
# data leaving the host, and fetching one is an action taken on somebody
# else's say-so. See docs/decisions/0015.
#
# Accepted types: image/png, image/jpeg, image/webp, text/plain, text/csv,
# text/markdown, application/json. PDF is deliberately excluded. Accepting a
# type is NOT a claim that anything can read it.
#
# Downloads use the same DISCORD_CDN_HOSTS allowlist as /schedule, exact host
# match, HTTPS only, no redirects.
CONVERSATION_ATTACHMENTS_ENABLED=false
# The coordinator's ceiling. The effective cap is the SMALLER of this and
# whatever the provider itself declares.
CONVERSATION_MAX_ATTACHMENT_BYTES=2097152
CONVERSATION_ATTACHMENTS_PER_HOUR=20

# ---- conversation continuity --------------------------------------------
# OPT IN, default off. When off, NOTHING you say in conversation is stored --
# which was the only behaviour before this existed, and is still the default.
#
# When on, turns are stored scoped to one (user, thread): two people in the
# same channel have two histories, one can never be read into the other, and a
# channel listed in DUCKY_*_SHARED_CHANNEL_IDS takes no part in memory at all.
# `/forget conversation` deletes every stored turn of every thread for you and
# reports the count -- and works even after this is switched off again.
# See docs/decisions/0021.
DUCKY_CONVERSATION_MEMORY_ENABLED=false
# How many earlier turns are replayed as context (2-40).
DUCKY_CONVERSATION_MEMORY_TURNS=10

# ---- schedule extraction ------------------------------------------------
# Phase 1 has no verified provider that can read images or PDFs, so those
# uploads are refused before download. Do not enable this without one.
SCHEDULE_BINARY_EXTRACTION_ENABLED=false
SCHEDULE_MAX_ATTACHMENT_BYTES=1048576
SCHEDULE_ATTACHMENTS_PER_HOUR=20

# --- conversation backend -----------------------------------------------------
# Which backend answers a plain message. EXPLICIT: never inferred from whether a
# URL is set. Development may omit this and get the marked `[mock]` provider.
# PRODUCTION MUST CHOOSE and refuses to start otherwise, and `mock` is refused
# for production outright -- a canned reply must never pass for a real one.
#   mock      - canned, every reply prefixed [mock]. Development only.
#   disabled  - conversation refuses clearly. The honest production mode today.
#   openclaw  - a real gateway; requires OPENCLAW_BASE_URL below.
DUCKY_CONVERSATION_PROVIDER=mock
# Loopback or a private tailnet address ONLY; a public URL is refused at boot.
# OpenClaw is not installed on this host and its API is unverified, so the
# provider throws rather than guessing. See docs/integrations/openclaw.md.
#OPENCLAW_BASE_URL=http://127.0.0.1:8080
#OPENCLAW_TIMEOUT_MS=30000

# --- logging ------------------------------------------------------------------
# `json` (default) or `text` for a readable local run. Every field is redacted
# either way.
DUCKY_LOG_FORMAT=json

# --- retention -----------------------------------------------------------------
# OFF by default, because this DELETES the owner's own records. With ENABLED
# false no window below is consulted and nothing is ever removed automatically.
#
# Nothing live is ever in scope, whatever these say: a non-terminal job, an open
# dependency, a held repository reservation, an open workspace, a pending
# approval, an undelivered reminder and an active credential are all protected
# by predicates, not by hoping the windows are large enough. `repos`,
# `authorized_user_audit`, `executors`, `executor_credentials` and
# `repo_reservations` have no delete path at all.
#
# Back up the SQLite file before enabling this on a populated database.
DUCKY_RETENTION_ENABLED=false
# Terminal jobs and every row that references them.
# Per-kind windows. Deliberately DIFFERENT from each other: a job's shape, a
# job's detailed result, a finished task and a past schedule entry are not the
# same kind of record, and one number for all of them meant choosing which to
# get wrong. See docs/decisions/0022.
#
# Job DETAIL (the result snapshot, events and your answers) goes before the job
# itself: it is the most specific thing Ducky stores about a repository, and
# every reader already handles a job with no result -- a queued one has none.
DUCKY_RETENTION_JOB_METADATA_DAYS=90
DUCKY_RETENTION_JOB_DETAIL_DAYS=30
DUCKY_RETENTION_DONE_CAPTURE_DAYS=365
DUCKY_RETENTION_CLOSED_TASK_DAYS=90
DUCKY_RETENTION_CLOSED_REMINDER_DAYS=90
DUCKY_RETENTION_PAST_SCHEDULE_DAYS=180
DUCKY_RETENTION_AUDIT_DAYS=90
# Closed tasks, closed reminders, done/archived captures, past confirmed schedules.
# DEPRECATED, still honoured rather than silently ignored. TERMINAL_JOBS_DAYS
# maps onto JOB_METADATA_DAYS; CLOSED_ASSISTANT_DAYS onto the four assistant
# windows. An explicit new value above always wins.
# DUCKY_RETENTION_TERMINAL_JOBS_DAYS=
# DUCKY_RETENTION_CLOSED_ASSISTANT_DAYS=
# Delivered or abandoned GitHub watch events.
DUCKY_RETENTION_WATCH_EVENTS_DAYS=90
# Idempotency keys, which can echo a response body.
DUCKY_RETENTION_IDEMPOTENCY_DAYS=7
# Stored conversation turns, by who said them. Your own history is kept longer
# than a chat-whitelist guest's, because they are not the same thing.
DUCKY_RETENTION_CONVERSATION_OWNER_DAYS=30
DUCKY_RETENTION_CONVERSATION_OTHER_DAYS=7
# Rows removed per table per pass, so a reconcile tick stays short.
DUCKY_RETENTION_BATCH=200
