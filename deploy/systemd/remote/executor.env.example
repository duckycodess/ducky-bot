# EXAMPLE ONLY. Copy to ~/.config/ducky/executor-<profile>.env, chmod 0600.
# No secret values here; they are filled in on the host and never committed.

DUCKY_COORDINATOR_URL=http://127.0.0.1:8787
DUCKY_EXECUTOR_ID=
DUCKY_EXECUTOR_KEY_ID=
# DUCKY_EXECUTOR_TOKEN=
# DUCKY_EXECUTOR_HMAC_SECRET=
DUCKY_HERDR_BIN=herdr
# REQUIRED. This profile's durable executor state: the pause outbox and the dispatch
# journal. The unit sets it per instance; set it yourself only when running without
# the unit. Absolute, owned by this user, mode 0700, no symlink in the path, and NOT
# under /tmp, /var/tmp, /dev/shm, /run, TMPDIR or XDG_RUNTIME_DIR (the executor
# refuses to start there): a temp sweep or a reboot must never be able to delete a
# pause the executor still owes. Never share it between profiles.
# DUCKY_EXECUTOR_STATE_DIR=/home/<user>/.local/state/ducky/<profile>/executor-state
# DUCKY_HERDR_VERIFIED=1   # a deliberate operator act after a certified probe

# Memory guard (enabled by the unit). Operator ESTIMATES, not measurements of
# Pi's footprint: tune from observed peak usage. The check reads the user slice
# and refuses to claim when (lower of memory.max/memory.high - memory.current) is
# below the sum. memory.current includes page cache, so it errs conservative.
# Before every prompt the guard also reads the cgroup of the agent's own foreground
# processes and every ancestor up to the cgroup mount, and the tightest remaining
# room must cover ALL THREE reserves below (deliberately conservative).
DUCKY_MEMORY_RESERVE_ENGINEERING_MIB=2048
DUCKY_MEMORY_RESERVE_NOTIFICATIONS_MIB=512
# The model provider's own process on this host. An estimate; 0 only where none shares the account.
DUCKY_MEMORY_RESERVE_PROVIDER_MIB=512
