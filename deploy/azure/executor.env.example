# TEMPLATE for /etc/ducky/executor-<profile>.env on a headless executor host.
#
# Mode 0600, owned by the `ducky` service account. Nothing in this repository
# writes this file; you do, over SSH, once.
#
# NOTHING HERE IS COPIED FROM ANOTHER MACHINE. Each executor has its own
# identity and its own credential, issued by the coordinator with
# `pnpm executor:issue-credential --executor <id>`. Copying the WSL executor's
# credential here would give two hosts one identity, which is the failure the
# placement model exists to prevent -- and it would mean a credential existed
# in two places, so revoking it would take down both.
#
# NO OAUTH OR TOKEN STORE IS COPIED HERE EITHER. The OpenClaw auth store stays
# on the machine where the owner signed in. This host runs an executor; the
# executor holds no model credential, has no conversation provider, and needs
# neither.

# Where the coordinator is. Over the tailnet, never a public address, and never
# 0.0.0.0 on the other end -- see ../tailscale/README.md.
DUCKY_COORDINATOR_URL=http://100.x.y.z:8788

# This host's identity. Unique across every machine that talks to this
# coordinator, and it must MATCH the `executorId` used in that repository's
# `placements` in the coordinator's repos file. A mismatch is not an error you
# will see at startup: the executor simply never gets handed any work, because
# no repository lists it.
DUCKY_EXECUTOR_ID=azure-prod

# Issued by the coordinator, printed once, never recoverable. If you lose them,
# issue a new credential and revoke the old key id -- do not go looking for the
# old values.
DUCKY_EXECUTOR_KEY_ID=REPLACE-ME
DUCKY_EXECUTOR_TOKEN=REPLACE-ME
DUCKY_EXECUTOR_HMAC_SECRET=REPLACE-ME

DUCKY_EXECUTOR_VERSION=0.1.0

# The orchestrator. `herdr` must be on this host's PATH for a real agent to
# run; without it the executor selects the MOCK orchestrator and says so, which
# is honest but is not doing the work.
DUCKY_HERDR_BIN=herdr

# DUCKY_HERDR_VERIFIED is deliberately absent. Setting it is an operator act
# based on evidence from `pnpm probe:live-job` on THIS host -- evidence from
# another machine is evidence about another machine.
